# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor (Render lo inyecta automáticamente).
PORT=3000

# Ruta del archivo SQLite. En Render apunta al disco persistente, p.ej. /var/data/arivaness.sqlite
DB_PATH=./data/arivaness.sqlite

# Poner en "true" cuando la app corra detrás de HTTPS (producción / Render).
COOKIE_SECURE=false

# Usuarios que se crean la primera vez que arranca la app.
# CAMBIA estas contraseñas antes de desplegar.
SEED_OWNER_USERNAME=juan
SEED_OWNER_PASSWORD=cambia-esta-clave
SEED_OWNER_NOMBRE=Juan Carlos

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_ADMIN_NOMBRE=Administradora

# Días que dura la sesión iniciada antes de pedir login de nuevo.
SESSION_DAYS=30
